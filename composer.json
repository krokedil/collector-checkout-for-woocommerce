{
    "name": "krokedil/walley-checkout-for-woocommerce",
    "description": "Extends WooCommerce. Provides a <a href=\"https://www.walley.se/foretag/checkout/\" target=\"_blank\">Walley Checkout</a> checkout for WooCommerce.",
    "type": "wordpress-plugin",
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.0",
        "phpstan/phpstan": "^2.1",
        "php-stubs/wordpress-stubs": "^6.0",
        "php-stubs/woocommerce-stubs": "^10.5.0",
        "php-stubs/woocommerce-subscriptions-stubs": "^9.1",
        "squizlabs/php_codesniffer": "^3.13",
        "wpify/scoper": "3.1.3"
    },
    "license": "GPL-v3",
    "require": {
        "php": "~7.4 || ~8.0",
        "krokedil/shop-widgets": "^0.1.0",
        "krokedil/woocommerce": "^1.0"
    },
    "repositories": {
        "krokedil/shop-widgets": {
            "type": "vcs",
            "url": "git@github.com:krokedil/shop-widgets.git"
        },
        "krokedil/woocommerce": {
            "type": "vcs",
            "url": "git@github.com:krokedil/woocommerce.git"
        }
    },
    "extra": {
        "wpify-scoper": {
            "prefix": "KrokedilWalleyDeps",
            "folder": "dependencies",
            "autorun": true,
            "globals": [
                "wordpress",
                "woocommerce"
            ]
        }
    },
    "config": {
        "platform": {
            "php": "7.4"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "wpify/scoper": true
        }
    },
    "scripts": {
        "get-changelog": "bash .github/scripts/new-version.sh",
        "update-version": "bash .github/scripts/new-version.sh update",
        "create-changelog": "bash .github/scripts/new-changelog.sh",
        "pre-release-check": [
            "bash .github/scripts/check-changelog-master.sh",
            "bash .github/scripts/check-version-and-compat.sh"
        ],
        "lint": "vendor/bin/phpcs . --standard=phpcs.xml --extensions=php -q",
        "lint:fix": "vendor/bin/phpcbf . --standard=phpcs.xml --extensions=php -q",
        "lint:changes": "git diff --name-only HEAD~1 | grep '\\.php$' | xargs vendor/bin/phpcs --standard=phpcs.xml --extensions=php -q",
        "lint:fix:changes": "git diff --name-only HEAD~1 | grep '\\.php$' | xargs vendor/bin/phpcbf --standard=phpcs.xml --extensions=php -q",
        "phpstan": "./vendor/bin/phpstan analyse --memory-limit=2G",
        "phpstan:baseline": "./vendor/bin/phpstan analyse --memory-limit=2G --generate-baseline",
        "wpify-scoper": "wpify-scoper"
    },
    "scripts-descriptions": {
        "phpstan": "Run PHPStan static analysis at the level set in phpstan.neon. Findings that predate the analysis are suppressed by phpstan-baseline.neon, so a failure means new code introduced it.",
        "phpstan:baseline": "Regenerate phpstan-baseline.neon from the current findings. Only run this when intentionally accepting new suppressions, otherwise fix the reported errors instead."
    }
}
